[config]
name="PhotoPicker"
binary="photo_picker.xcframework"

linker_flags="-Wl,-weak-lswiftCompatibility50 -Wl,-weak-lswiftCompatibility51 -Wl,-weak-lswiftCompatibility56 -Wl,-weak-lswiftCompatibilityConcurrency -ObjC"
frameworks="Photos,PhotosUI,UIKit,Foundation"

initialization="godot_photopicker_init"
deinitialization="godot_photopicker_deinit"



[dependencies]
linked=[]
embedded=[]
system=[]

capabilities=[]

files=[]

[plist]
NSPhotoLibraryUsageDescription:string_input="Photo Library usage description"
NSCameraUsageDescription:string_input="Camera usage description"
